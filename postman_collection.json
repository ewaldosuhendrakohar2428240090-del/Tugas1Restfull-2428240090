                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data.namaPelanggan).to.eql(\"Fajar Pratama Updated\");",
                  "    pm.expect(jsonData.data.status).to.eql(\"Lunas\");",
                  "});"
                ],
