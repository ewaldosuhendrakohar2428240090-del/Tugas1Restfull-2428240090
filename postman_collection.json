{
  "info": {
    "_postman_id": "c1f7b029-9e5c-4c4f-a728-electricitybills",
    "name": "Tugas 2 - Utilitas Tagihan Listrik API Automation",
    "description": "Koleksi Postman untuk pengujian otomatis (Automated Testing) RESTful API Utilitas Tagihan Listrik (/electricity-bills) oleh Ewaldo Suhendra Kohar (2428240090).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. CRUD (Skenario Sukses)",
      "item": [
        {
          "name": "1. GET Info API (GET /)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response memiliki informasi status success dan topik tagihan listrik\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.topik).to.eql(\"Utilitas Tagihan Listrik\");",
                  "    pm.expect(jsonData.nim).to.eql(\"2428240090\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Memastikan server menyala dan info API tampil."
          },
          "response": []
        },
        {
          "name": "2. GET Semua Tagihan Listrik",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response berbentuk array dan data tidak kosong\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Objek data tagihan memiliki field id, nomorPelanggan, dan totalTagihan\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData[0]).to.have.property(\"id\");",
                  "    pm.expect(jsonData[0]).to.have.property(\"golongan\");",
                  "    pm.expect(jsonData[0]).to.have.property(\"totalTagihan\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electricity-bills",
              "host": ["{{baseUrl}}"],
              "path": ["electricity-bills"]
            },
            "description": "Mengambil seluruh daftar tagihan listrik."
          },
          "response": []
        },
        {
          "name": "3. POST Tambah Tagihan Listrik Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response memiliki status success dan data tersimpan dengan id baru\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data).to.have.property(\"id\");",
                  "    pm.expect(jsonData.data.namaPelanggan).to.eql(\"Fajar Pratama\");",
                  "    pm.expect(jsonData.data.golongan).to.eql(\"R1-900VA\");",
                  "});",
                  "",
                  "pm.test(\"Simpan ID tagihan listrik baru ke environment variable billId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.be.a(\"number\");",
                  "    pm.environment.set(\"billId\", jsonData.data.id);",
                  "    console.log(\"billId disimpan ke environment:\", jsonData.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomorPelanggan\": \"512033445566\",\n  \"namaPelanggan\": \"Fajar Pratama\",\n  \"golongan\": \"R1-900VA\",\n  \"bulan\": \"Februari 2025\",\n  \"pemakaianKwh\": 135,\n  \"totalTagihan\": 182250,\n  \"status\": \"Belum Lunas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/electricity-bills",
              "host": ["{{baseUrl}}"],
              "path": ["electricity-bills"]
            },
            "description": "Menambahkan data tagihan listrik baru dan menyimpan ID yang dihasilkan ke environment variable billId."
          },
          "response": []
        },
        {
          "name": "4. GET Tagihan Listrik by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"ID data tagihan listrik sesuai dengan variabel billId\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const expectedId = parseInt(pm.environment.get(\"billId\"));",
                  "    pm.expect(jsonData.id).to.eql(expectedId);",
                  "    pm.expect(jsonData.namaPelanggan).to.eql(\"Fajar Pratama\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electricity-bills/{{billId}}",
              "host": ["{{baseUrl}}"],
              "path": ["electricity-bills", "{{billId}}"]
            },
            "description": "Mengambil satu data spesifik menggunakan ID dari environment variable."
          },
          "response": []
        },
        {
          "name": "5. PUT Update Tagihan Listrik",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
