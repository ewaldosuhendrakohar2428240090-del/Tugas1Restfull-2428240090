            "url": {
              "raw": "{{baseUrl}}/electricity-bills/{{billId}}",
              "host": ["{{baseUrl}}"],
              "path": ["electricity-bills", "{{billId}}"]
            },
            "description": "Memperbarui data tagihan listrik menggunakan ID yang aktif di environment."
          },
          "response": []
        },
        {
          "name": "6. GET Filter Tagihan by Golongan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Semua data yang dikembalikan memiliki golongan R1-900VA\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    jsonData.forEach(function(item) {",
                  "        pm.expect(item.golongan.toLowerCase()).to.eql(\"r1-900va\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electricity-bills?golongan=R1-900VA",
              "host": ["{{baseUrl}}"],
              "path": ["electricity-bills"],
              "query": [
                {
                  "key": "golongan",
                  "value": "R1-900VA"
                }
              ]
            },
            "description": "Menguji filtering query parameter golongan."
          },
          "response": []
        },
        {
          "name": "7. DELETE Tagihan Listrik by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Pesan konfirmasi data berhasil dihapus\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.message).to.include(\"berhasil dihapus\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/electricity-bills/{{billId}}",
