              "mode": "raw",
              "raw": "{\n  \"nomorPelanggan\": \"512033445566\",\n  \"namaPelanggan\": \"Fajar Pratama Updated\",\n  \"golongan\": \"R1-900VA\",\n  \"bulan\": \"Februari 2025\",\n  \"pemakaianKwh\": 135,\n  \"totalTagihan\": 182250,\n  \"status\": \"Lunas\"\n}",
              "options": {
                "raw": {
